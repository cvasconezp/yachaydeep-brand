{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand":            { "value": "#1B3A6B", "description": "Navy institucional — fondos de autoridad, texto sobre claro" },
    "brand-dark":       { "value": "#0F2444", "description": "Navy profundo — gradientes y footer" },
    "brand-light":      { "value": "#2B5AA0", "description": "Azul activo — hovers y enlaces sobre oscuro" },
    "brand-gold":       { "value": "#E8A838", "description": "Dorado — SOLO acciones y acentos. No usar como fondo extenso" },
    "brand-gold-light": { "value": "#F5C563", "description": "Dorado hover" },
    "brand-ice":        { "value": "#A8DCE8", "description": "Hielo — detalles fríos sobre navy" },
    "brand-ice-light":  { "value": "#D8EFF4", "description": "Hielo claro — fondos suaves" }
  },
  "font": {
    "display": { "value": "\"Bricolage Grotesque\", \"Instrument Sans\", system-ui, sans-serif", "description": "Titulares y héroes (pesos 600-800)" },
    "sans":    { "value": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "description": "Cuerpo e interfaz" },
    "mono":    { "value": "\"Spline Sans Mono\", ui-monospace, \"Cascadia Code\", monospace", "description": "Datos, código, coordenadas, handles" }
  },
  "radius": {
    "card": { "value": "1rem", "description": "rounded-2xl — tarjetas estándar" },
    "hero-card": { "value": "1.5rem", "description": "rounded-3xl — tarjetas protagonistas" }
  },
  "gradient": {
    "navy": { "value": "linear-gradient(to bottom right, #1B3A6B, #0F2444, #1B3A6B)", "description": "Secciones oscuras (from-brand via-brand-dark to-brand)" },
    "gold-bar": { "value": "linear-gradient(to right, #1B3A6B, #E8A838, #F5C563)", "description": "Barra superior de tarjetas destacadas" }
  }
}
